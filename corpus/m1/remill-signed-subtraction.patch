+// 8615:1857 PACKSSWB PACKSSWB_MMXq_MMXq MMX MMX PENTIUMMMX ATTRIBUTES: HALF_WIDE_OUTPUT NOTSX
+
+namespace {
+
+template <typename D, typename S1, typename S2>
+DEF_SEM(PSUBSB, D dst, S1 src1, S2 src2) {
+  auto left = SReadV8(src1);
+  auto right = SReadV8(src2);
+  auto result = SClearV8(SReadV8(dst));
+  _Pragma("unroll") for (size_t i = 0; i < NumVectorElems(left); ++i) {
+    auto a = SExtractV8(left, i);
+    auto b = SExtractV8(right, i);
+    auto value = SSub(SExt(a), SExt(b));
+    auto minimum = SExt(Minimize(a));
+    auto maximum = SExt(Maximize(a));
+    value = Select(SCmpLt(value, minimum), minimum, value);
+    value = Select(SCmpGt(value, maximum), maximum, value);
+    result = SInsertV8(result, i, Trunc(value));
+  }
+  SWriteV8(dst, result);
+  return memory;
+}
+
+template <typename D, typename S1, typename S2>
+DEF_SEM(PSUBSW, D dst, S1 src1, S2 src2) {
+  auto left = SReadV16(src1);
+  auto right = SReadV16(src2);
+  auto result = SClearV16(SReadV16(dst));
+  _Pragma("unroll") for (size_t i = 0; i < NumVectorElems(left); ++i) {
+    auto a = SExtractV16(left, i);
+    auto b = SExtractV16(right, i);
+    auto value = SSub(SExt(a), SExt(b));
+    auto minimum = SExt(Minimize(a));
+    auto maximum = SExt(Maximize(a));
+    value = Select(SCmpLt(value, minimum), minimum, value);
+    value = Select(SCmpGt(value, maximum), maximum, value);
+    result = SInsertV16(result, i, Trunc(value));
+  }
+  SWriteV16(dst, result);
+  return memory;
+}
+
+}  // namespace
